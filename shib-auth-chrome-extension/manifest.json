{
  "manifest_version": 3,
  "name": "UCI ZotGPT Authentication Helper",
  "version": "1.0",
  "permissions": ["cookies", "webNavigation", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}